   "source": [
    "train = pd.read_csv(REPO / \"data\" / \"train.csv\", dtype={\"id\": str})\n",
    "test = pd.read_csv(REPO / \"data\" / \"test.csv\", dtype={\"id\": str})\n",
    "\n",
    "y = train[\"is_canceled\"].to_numpy()\n",
    "assert set(np.unique(y)) == {0, 1}\n",
    "\n",
    "rng = np.random.default_rng(SEED)\n",
    "valid_idx = np.sort(np.concatenate([\n",
    "    rng.permutation(np.flatnonzero(y == lab))[:int(np.ceil(0.2 * (y == lab).sum()))]\n",
    "    for lab in (0, 1)\n",
    "]))\n",
    "train_idx = np.setdiff1d(np.arange(len(train)), valid_idx)\n",
    "\n",
    "X_raw = train.drop(columns=[\"id\", \"is_canceled\"])\n",
    "y_tr, y_va = y[train_idx], y[valid_idx]\n",
    "print(f\"train={len(train_idx)} {np.bincount(y_tr).tolist()} | \"\n",
    "      f\"valid={len(valid_idx)} {np.bincount(y_va).tolist()}\")"
   ]
  },
