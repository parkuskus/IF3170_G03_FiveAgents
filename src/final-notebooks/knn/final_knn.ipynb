   "id": "52bf8ec0",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-05T14:08:05.422786Z",
     "iopub.status.busy": "2026-11-05T14:08:05.422106Z",
     "iopub.status.idle": "2026-11-05T14:08:05.442058Z",
     "shell.execute_reply": "2026-11-05T14:08:05.441184Z"
    }
   },
   "outputs": [
