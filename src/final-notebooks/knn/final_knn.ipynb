    "Xv_va = pre_v.transform(X_raw.iloc[valid_idx])\n",
    "\n",
    "previous_model = KNNClassifier(BEST_K, BEST_WEIGHTS, metric=PREVIOUS_METRIC).fit(Xv_tr, y_tr)\n",
    "previous_prediction = previous_model.predict(Xv_va)\n",
    "previous_f1 = f1_score(y_va, previous_prediction, labels=[0, 1], average=\"macro\", zero_division=0)\n",
    "\n",
    "validation_model = KNNClassifier(BEST_K, BEST_WEIGHTS, metric=BEST_METRIC, p=BEST_P).fit(Xv_tr, y_tr)\n",
    "pred_va = validation_model.predict(Xv_va)\n",
    "f1 = f1_score(y_va, pred_va, labels=[0, 1], average=\"macro\", zero_division=0)\n",
    "cm = confusion_matrix(y_va, pred_va, labels=[0, 1])\n",
    "p, r, f, _ = precision_recall_fscore_support(y_va, pred_va, labels=[0, 1], zero_division=0)\n",
    "print(f\"Metode lama Euclidean macro F1 {previous_f1:.6f}\")\n",
    "print(f\"Metode baru Manhattan macro F1 {f1:.6f}\")\n",
